<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<suite name="HoverPageTestSuite" verbose="1">

  <test name="Hover Test User 1">
    <parameter name="browser" value="firefox"/>
    <parameter name="user" value="1"/>
    <classes>
      <class name="com.herokuapp.theinternet.tests.HoverTest"/>
    </classes>
  </test>

  <test name="Dropdown Test User 2">
    <parameter name="browser" value="chrome"/>
    <parameter name="user" value="2"/>
    <classes>
      <class name="com.herokuapp.theinternet.tests.HoverTest"/>
    </classes>
  </test>

  <test name="Dropdown Test User 3">
    <parameter name="browser" value="chrome"/>
    <parameter name="user" value="3"/>
    <classes>
      <class name="com.herokuapp.theinternet.tests.HoverTest"/>
    </classes>
  </test>

</suite>
