      <class name="com.herokuapp.theinternet.tests.SliderTest"/>
    </classes>
  </test>

  <test name="Slider Test Position 2">
    <parameter name="browser" value="firefox"/>
    <parameter name="position" value="2"/>
    <classes>
      <class name="com.herokuapp.theinternet.tests.SliderTest"/>
